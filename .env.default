PORT=
PORT_PROD=
APP_ENV=development
APP_DATABASE_URL=sqlite://var/dev/knowledge_management.sqlite3
DATABASE_GENERATE_SCHEMAS=1
MYSQL_CONNECTOR_STRING=

REDIS_URL=redis://localhost:6379/0
REDIS_RECONNECT_DELAY_SECONDS=5
FILE_INGEST_QUEUE_KEY=km:file_ingest_queue
FILE_STATUS_CHANNEL=km:file_status_events
FILE_INDEX_VERSION=pdf-v1

VECTOR_STORE_BACKEND=pglite
PGLITE_SERVICE_URL=http://127.0.0.1:5434
PGLITE_DATA_DIR=./var/pglite
PGLITE_HTTP_HOST=127.0.0.1
PGLITE_HTTP_PORT=5434
PGLITE_SOCKET_ENABLED=0
PGLITE_HOST=127.0.0.1
PGLITE_PORT=5433
PGLITE_MAX_CONNECTIONS=1
PGLITE_IDLE_TIMEOUT_MS=30000
PGLITE_BACKUP_DIR=./var/pglite-backups
PGLITE_BACKUP_INTERVAL_HOURS=24
# Optional cosine-similarity floor. Empty keeps the top-k results without a score cutoff.
PGLITE_MIN_COSINE_SIMILARITY=

# Use a long random value. Required whenever provider API keys are configured.
AI_ENDPOINT_SECRET_KEY=
AI_ENDPOINT_HTTP_ALLOWLIST=localhost,127.0.0.1
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5222
LLM_MAX_OUTPUT_TOKENS=4096
LOG_SENSITIVE_AI_CONTENT=0

FILE_STATIC_ABSOLUTE_PATH=
FILE_UPLOAD_ABSOLUTE_PATH=
SERVE_PUBLIC_UPLOADS=0

URL_STATIC_BASE_URL=
URL_UPLOAD_BASE_URL=

ES_USERNAME=
ES_PASSWORD=
ES_HOST=
ES_REMOVE_LOWSCORE_SEARCH_RESULTS=0
ES_DEBUG=1

ES_CHATLLM_LLM_MODEL_ENABLE_API=1
ES_CHATLLM_LLM_CONTROLLER_DEBUG=1
