# Copy this file to .env.client and adjust credentials/endpoints as needed.
# The defaults match the local developer environment described in the project brief.

ES_HOST=http://localhost:9200
ES_USERNAME=elasic
ES_PASSWORD=octopuspass
ES_VERBOSE=0
ES_DEBUG=0
ES_EMBEDDING_MODEL="moka-ai/m3e-base"
